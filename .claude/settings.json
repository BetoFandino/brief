{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "permissions": {
    "deny": [
      "Bash(kubectl apply:*)",
      "Bash(kubectl create:*)",
      "Bash(kubectl delete:*)",
      "Bash(kubectl patch:*)",
      "Bash(kubectl replace:*)",
      "Bash(kubectl edit:*)",
      "Bash(kubectl set:*)",
      "Bash(kubectl scale:*)",
      "Bash(kubectl autoscale:*)",
      "Bash(kubectl annotate:*)",
      "Bash(kubectl label:*)",
      "Bash(kubectl taint:*)",
      "Bash(kubectl cordon:*)",
      "Bash(kubectl uncordon:*)",
      "Bash(kubectl drain:*)",
      "Bash(kubectl rollout:*)",
      "Bash(kubectl run:*)",
      "Bash(kubectl expose:*)",
      "Bash(kubectl exec:*)",
      "Bash(kubectl attach:*)",
      "Bash(kubectl cp:*)",
      "Bash(kubectl debug:*)",
      "Bash(helm install:*)",
      "Bash(helm upgrade:*)",
      "Bash(helm uninstall:*)",
      "Bash(helm delete:*)",
      "Bash(helm rollback:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/no-cluster-writes.sh",
            "timeout": 10,
            "statusMessage": "Checking read-only principle"
          }
        ]
      }
    ]
  }
}
